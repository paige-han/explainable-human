# Copy to .env and fill in. With no OPENAI_API_KEY the piece runs in DEMO mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — the 2022 installation used Naver Papago for ko↔en translation.
# Without these, translation falls back to the LLM (or passthrough in DEMO mode).
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=

# Visitor answers are appended to app/data/*.json (git-ignored). Set false to disable.
LOG_RESPONSES=true
PORT=3000
